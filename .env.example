# --- Server ---------------------------------------------------------------
# Domain pointed at your droplet (A record). Caddy gets the HTTPS certificate.
DOMAIN=agent.example.com
# Random strong passwords: `openssl rand -hex 24`
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me
ADMIN_PASSWORD=change-me

# --- Twilio ---------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567

# --- Voice calls ----------------------------------------------------------
# gpt-live (default): OpenAI GPT-Live talks on calls, Claude does the work it delegates.
# claude-relay: Twilio ConversationRelay text-to-speech with Claude speaking directly.
VOICE_ENGINE=gpt-live
OPENAI_API_KEY=sk-...
OPENAI_LIVE_MODEL=gpt-live-1
# Built-in voices include marin, cedar, alloy, coral, sage, verse, ...
OPENAI_LIVE_VOICE=marin
# Twilio <Say> voice for the recording disclosure played at the start of every call
DISCLOSURE_VOICE=Polly.Joanna-Neural
# Only used with VOICE_ENGINE=claude-relay, e.g. en-US-Journey-O (Google) or an ElevenLabs voice id
TWILIO_TTS_VOICE=

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5

# --- Agent behavior -------------------------------------------------------
AGENT_NAME=Tuah
DEFAULT_COUNTRY=US
ALLOWED_COUNTRIES=US,CA
MAX_OUTBOUND_PER_USER_PER_DAY=20
# Third parties are only contacted between these hours in TIMEZONE.
CONTACT_HOURS_START=8
CONTACT_HOURS_END=21
TIMEZONE=America/New_York
MAX_CALL_MINUTES=15
